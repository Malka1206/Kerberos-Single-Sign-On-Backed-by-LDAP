# ---------- Naming ----------
DOMAIN=lab.test
REALM=LAB.TEST
BASE_DN=dc=lab,dc=test

# ---------- Network ----------
# Address at which the Kali VM reaches the Windows host
HOST_IP=192.168.56.1

# ---------- Published ports (adjustable) ----------
KDC_PORT=88
KPASSWD_PORT=464
KADMIN_PORT=749
LDAP_PORT=389
LDAPS_PORT=636
WEB_PORT=80

# ---------- LDAP accounts ----------
LDAP_ADMIN_PASSWORD=change-me
SSSD_BIND_PASSWORD=change-me
KDC_BIND_PASSWORD=change-me
KADMIN_BIND_PASSWORD=change-me

# ---------- Kerberos ----------
KDC_MASTER_PASSWORD=change-me
ADMIN_PASSWORD=change-me

# ---------- Example user passwords ----------
ALICE_PASSWORD=change-me
BOB_PASSWORD=change-me
CAROL_PASSWORD=change-me
