dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword by anonymous auth by * none
olcAccess: {1}to attrs=krbPrincipalKey by dn.exact="cn=kadmin,ou=services,dc=lab,dc=test" write by dn.exact="cn=kdc,ou=services,dc=lab,dc=test" read by * none
olcAccess: {2}to dn.subtree="cn=kerberos,dc=lab,dc=test" by dn.exact="cn=kadmin,ou=services,dc=lab,dc=test" write by dn.exact="cn=kdc,ou=services,dc=lab,dc=test" read by * none
olcAccess: {3}to dn.subtree="ou=people,dc=lab,dc=test" attrs=krbLastSuccessfulAuth,krbLastFailedAuth,krbLoginFailedCount,krbExtraData by dn.exact="cn=kadmin,ou=services,dc=lab,dc=test" write by dn.exact="cn=kdc,ou=services,dc=lab,dc=test" write by * none
olcAccess: {4}to dn.subtree="ou=people,dc=lab,dc=test" by dn.exact="cn=kadmin,ou=services,dc=lab,dc=test" write by dn.exact="cn=kdc,ou=services,dc=lab,dc=test" read by * break
olcAccess: {5}to dn.subtree="ou=people,dc=lab,dc=test" attrs=entry,objectClass,ou,cn,sn,givenName,uid,uidNumber,gidNumber,homeDirectory,loginShell,gecos,description by dn.exact="cn=sssd,ou=services,dc=lab,dc=test" read by * none
olcAccess: {6}to dn.subtree="ou=groups,dc=lab,dc=test" by dn.exact="cn=sssd,ou=services,dc=lab,dc=test" read by * none
olcAccess: {7}to dn.base="dc=lab,dc=test" by dn.exact="cn=sssd,ou=services,dc=lab,dc=test" read by dn.exact="cn=kdc,ou=services,dc=lab,dc=test" read by dn.exact="cn=kadmin,ou=services,dc=lab,dc=test" read by * none
olcAccess: {8}to * by * none
